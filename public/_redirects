# SPA Fallback - Redirect all routes to index.html for React Router
/* /index.html 200

# API Redirects (if using external APIs)
/api/* https://api.oceanvista.gov.in/v2/:splat 200
/api-access/* https://api.oceanvista.gov.in/v2/:splat 200

# Force HTTPS redirect
https://oceanvista.netlify.app/* https://marine-intelligence.netlify.app/:splat 301!

# WWW to non-WWW redirect
https://www.marine-intelligence.netlify.app/* https://marine-intelligence.netlify.app/:splat 301!

# Old URLs to new structure redirects
/dashboard /dashboard 200
/data /datasets 301
/visualizations /visualization 301
/ai /ai-tools 301
/api-docs /api-access 301

# Security headers
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.oceanvista.gov.in;

# Cache static assets
/static/* /static/:splat 200
  Cache-Control: public, max-age=31536000, immutable

# Images and assets
/images/* /images/:splat 200
  Cache-Control: public, max-age=604800

# 404 page
/404 /404.html 200
